# Optional: when configured, real public-place addresses come from Google Places.
GOOGLE_MAPS_API_KEY=
PAY153_BILLING_ADDRESS_CACHE=/opt/pay153/data/billing_addresses.json
# 本地第一跳代理；代理池条目会作为第二跳/最终出口。
PAY153_PROXY_PRE_PROXY=socks5://127.0.0.1:9697
# PayPal approve 后等待 Stripe 生成跳转地址的轮询次数。
PAYPAL_APPROVE_POLL_ATTEMPTS=6
# 同一任务内连续 PayPal 风控拒绝（generic_decline 等）达到该次数后熔断任务。
# 账号冷却时长由前端本地账号库控制（默认 60 分钟，工程降频，非官方规定）。
PAYPAL_GENERIC_DECLINE_STREAK=3

# OAICS PayPal 本地 HTTP 链路。confirm 默认携带当前账号 Bearer，避免旧 HAR
# 中缺少认证头导致 HTTP 401；如需复现实验 HAR 才设为 0。
PAY153_OAICS_PUBLISHABLE_KEY=
PAY153_OAICS_CONFIRM_AUTH=1
PAY153_OAI_CLIENT_VERSION=prod-1827e06d85a24a9606e4199dd07d869724cd0915
PAY153_OAI_CLIENT_BUILD_NUMBER=8953813
# 以下字段是运行时/签名字段，通常保持为空；不要填入过期 HAR 值。
PAY153_OAI_WEB_DEPLOYMENT_ATTESTATION=
PAY153_OAI_TELEMETRY=
PAY153_OAI_CLIENT_OBSERVATION=
PAY153_OAICS_USER_AGENT=
# hCaptcha 是动态、一次性字段；没有当前有效值时保持为空，不要复用旧 HAR token。
PAY153_OAICS_HCAPTCHA_TOKEN=
PAY153_STRIPE_JS_VERSION=4dae3e22af
PAY153_OAICS_TIME_ON_PAGE=42000

# Management center. Leave the password empty to keep /manage disabled.
PAY153_MANAGE_PASSWORD=
# Set stable values in production; otherwise the session secret changes on restart.
PAY153_SESSION_SECRET=
# Optional Fernet key. If empty, the app creates data/.manage.key automatically.
PAY153_MANAGE_ENCRYPTION_KEY=
PAY153_MANAGE_DB=data/pay153_manage.sqlite3
PAY153_MANAGE_KEY_FILE=data/.manage.key
